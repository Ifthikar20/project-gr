# Xcode project is generated by XcodeGen (`xcodegen`) — never committed
GemRun.xcodeproj/

# Xcode / SPM
xcuserdata/
DerivedData/
.build/
.swiftpm/
*.xcuserstate
timeline.xctimeline
playground.xcworkspace

# Secrets (copy Configs/Secrets.example.xcconfig → Configs/Secrets.xcconfig)
Configs/Secrets.xcconfig
# Device backend URL — regenerated by `./run.sh device` (per-network LAN IP)
Configs/DevAPI.xcconfig

# Backend (Django)
backend/db.sqlite3
backend/.venv/
backend/.server.log
backend/.server.pid
__pycache__/
*.pyc

# run.sh + device build output
build/
build-device/

# XcodeGen also writes these from project.yml on every run — regenerable.
App/GemRun.entitlements
App/Info.plist

# OS
.DS_Store
