# GemRun backend configuration — copy to `.env` and fill in.
#   cp .env.example .env      (docker compose auto-loads .env)
#
# EVERY scaling step below is a value change here, not a code change. The
# code seams are already in place; see docs/20-scaling-runbook.md for which
# lines to set at each user tier.
# ---------------------------------------------------------------------------

# ── Always set in production (any tier past local dev) ─────────────────────
GEMRUN_DEBUG=0
# Generate: python -c 'import secrets;print(secrets.token_hex(32))'
GEMRUN_SECRET_KEY=
GEMRUN_ALLOWED_HOSTS=api.gemrun.app
# strict = verify Apple/Google tokens, guests use a secret (production).
# insecure_dev = permissive, local/mock only (boot guard forbids it if DEBUG=0).
GEMRUN_AUTH_MODE=strict
# Provider audiences for identity-token verification (the app's client ids).
GEMRUN_APPLE_AUDIENCE=com.gemrun.GemRun
GEMRUN_GOOGLE_AUDIENCE=

# ── Tier 500+: Postgres instead of SQLite ──────────────────────────────────
# Set GEMRUN_DB_HOST to switch the whole app to Postgres.
GEMRUN_DB_HOST=db
GEMRUN_DB_NAME=gemrun
GEMRUN_DB_USER=gemrun
GEMRUN_DB_PASSWORD=
GEMRUN_DB_PORT=5432
GEMRUN_DB_CONN_MAX_AGE=60

# ── Tier 500+: Redis (shared cache + shared rate-limit counter) ────────────
# Without this, each gunicorn worker keeps its own throttle counter and cache.
GEMRUN_REDIS_URL=redis://redis:6379/0

# ── Read-through caching (on by default; offloads hot reads to Redis) ───────
# Master switch, and TTLs in seconds for the catalog / map read / advisory
# mile-count. Leave as-is normally; set GEMRUN_READ_CACHE=0 to bypass.
GEMRUN_READ_CACHE=1
GEMRUN_CACHE_TTL_CATALOG=3600
GEMRUN_CACHE_TTL_DROPS=5
GEMRUN_CACHE_TTL_MILE=5

# ── Tier 12k+: read replica (heavy read queries route here automatically) ──
# Leave blank until you add a replica; then just set the host.
GEMRUN_DB_REPLICA_HOST=
GEMRUN_DB_REPLICA_PORT=5432

# ── Tier 12k+: self-hosted OSM walkability (stops depending on Overpass) ────
# Set to "postgis" AFTER importing an OSM extract (see api/walkability_pg.py).
GEMRUN_WALKABILITY_SOURCE=overpass

# ── Tier 12k+: background stocking on a Celery queue instead of the pool ────
# Set to "celery" AND run a worker: celery -A gemrun.celery_app worker -l info
GEMRUN_STOCKING_BACKEND=thread
GEMRUN_CELERY_BROKER=redis://redis:6379/1

# ── gunicorn (the web server) ──────────────────────────────────────────────
# Default worker count is (2 × CPU cores) + 1; override per box if needed.
# GUNICORN_WORKERS=9
# GUNICORN_THREADS=4
# GUNICORN_BIND=0.0.0.0:8000
